# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viewings_chat?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=60000

# App URLs
APP_URL=http://localhost:5174
# Comma-separated browser origins allowed by CORS (Vite may use 5173 or 5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
API_URL=http://localhost:3000
PORT=3000

# Demo seed credentials
DEMO_SEEKER_EMAIL=seeker@viewings.demo
DEMO_LISTER_EMAIL=lister@viewings.demo
DEMO_ADMIN_EMAIL=admin@viewings.demo
DEMO_PASSWORD=DemoPass123!

# Timezone
TZ=Pacific/Auckland
